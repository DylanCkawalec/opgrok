# Patterns with a leading / are repo-root only.
# Do not write a bare `docs/` — that would also hide core/skills/docs/.

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/.venv/
/venv/
/ENV/
/env/

# ── Rust ──────────────────────────────────────────────────────────────────
/target/
Cargo.lock
**/*.rs.bk

# ── Secrets ───────────────────────────────────────────────────────────────
.env
.env.local
*.key
*.pem

# ── Editors / OS ──────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
*.bak
.vscode/
.idea/
*.swp
*.swo
.cursor/

# ── Logs / temp / DBs ─────────────────────────────────────────────────────
*.log
/logs/
/tmp/
/temp/
*.tmp
*.db
*.sqlite
*.sqlite3
*.db-journal

# ── Node ──────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*

# ── Build artifacts ───────────────────────────────────────────────────────
/dist/
/build/
*.egg-info/

# ── Per-clone factory output ──────────────────────────────────────────────
/core/binaries/

# ── Personal (not the public CLI) ─────────────────────────────────────────
/tests/
/docs/
/apps/
/webapp/
/examples/
/_analysis/
/.n8n/
/n8n_data/
/postgres_data/
/.grok-plugin/
/.grok/workflows/

# Web UI kit + planning notes (CLI ships brand marks only)
/assets/ui/
/assets/app/
/assets/assets.md
/assets/prompts/

# n8n / web helper scripts
/ops/scripts/run.sh
/ops/scripts/run_n8n.sh
/ops/scripts/run_n8n_local.sh
/ops/scripts/run_genius_mode.sh
/ops/scripts/stop_n8n_local.sh
