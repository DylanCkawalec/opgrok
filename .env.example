# ═══════════════════════════════════════════════════════════════════════════
# OPGROK — Environment Example (v1.0.0)
# Last updated: 2026-08-15
# Copy to `.env` and fill in your values. Never commit the real `.env`.
# ═══════════════════════════════════════════════════════════════════════════

# ── xAI API Key ───────────────────────────────────────────────────────────
# Get one at https://console.x.ai/
# Required for live runs. Missing/empty key forces dry-run (or FAIL with
# OPGROK_REQUIRE_LIVE=1).
XAI_API_KEY=

# ── Default Grok model ────────────────────────────────────────────────────
# Used when OPGROK_MODEL is not set. grok-4.6 is the newest flagship
# (released 2026-08-01): best for coding, agentic tasks, and knowledge work.
# 500K context window. $2/$6 per 1M input/output tokens.
# See: https://docs.x.ai/developers/models
DEFAULT_MODEL=grok-4.6

# ═══════════════════════════════════════════════════════════════════════════
# OPGROK Grok-native toolkit
# ═══════════════════════════════════════════════════════════════════════════

# ── Model tiers ───────────────────────────────────────────────────────────
# Three tiers for the harness: strong (main work), fast (lightweight tasks),
# and judge (decisive node). All default to the latest available models.

# Strong tier: primary execution model for forge/smith/seal nodes.
# grok-4.6 — newest flagship, best intelligence per unit of time and cost.
# Alternatives: grok-4.5 (previous flagship, 2x token efficiency),
#               grok-4.3 (1M context, cheaper at $1.25/$2.50).
OPGROK_MODEL=grok-4.6

# Fast tier: lightweight tasks (docs, scout, trace, audit).
# grok-4.5 — previous flagship, still excellent quality with 2x token
# efficiency, making it cheaper in practice despite higher per-token cost.
# Alternatives: grok-4.1-fast ($0.20/$0.50, fastest latency at 0.54s),
#               grok-3-mini (cheapest, $0.30/$0.50, 128K context).
OPGROK_MODEL_FAST=grok-4.5

# Judge tier: decisive node that seals the verdict.
# grok-4.6 — best model for judging, highest reasoning quality.
# Falls back to OPGROK_MODEL if not set.
OPGROK_MODEL_JUDGE=grok-4.6

# ── Reasoning effort ──────────────────────────────────────────────────────
# grok-4.6/4.5 reasoning levels: low | medium | high
# high = best quality (default), low = fastest, medium = balanced.
OPGROK_REASONING_EFFORT=high

# ── Execution limits ──────────────────────────────────────────────────────
# Max repair retries per node (0 = no retries, 1 = initial + 1 repair).
OPGROK_MAX_RETRIES=1

# Max output tokens per API call. grok-4.6 supports up to 500K context.
# 4096 is a good default for scout/audit/judge nodes.
OPGROK_MAX_TOKENS=4096

# Producer nodes (forge/smith/seal) emit full source files. grok-4.6
# reasoning can eat 8k before any JSON — 32768 is the factory default.
OPGROK_MAX_TOKENS_PRODUCER=32768

# After a live harvest, if cargo fails, ask the last rust/code forge to
# rewrite sources using rustc errors. 0 disables. 1 is enough for most crates.
OPGROK_COMPILE_REPAIRS=1

# HTTP timeout per API call in seconds.
OPGROK_HTTP_TIMEOUT=600

# ── Toolkit capabilities (1=on, 0=off) ────────────────────────────────────
# Parallel DAG wave execution (topo_layers + ready_wave).
OPGROK_PARALLEL=1

# Shell tool — OFF by default (security: T3 shell RCE).
# Enable only in sandboxed environments. Never document the regex as the
# boundary (see WINNING_CONDITION_v1.0.0.md #21).
OPGROK_ALLOW_SHELL=0

# Network tools (web_fetch) — ON by default but SSRF-protected in v1.0.0.
# v1.0.0 closes T2: refuses loopback/private/link-local/metadata ranges,
# re-validates redirect hops, byte-caps before buffering.
OPGROK_ALLOW_NET=1

# Persistent memory store (memory/blackboard.json).
# v1.0.0 fix: only PASS runs write memory; dry/FAIL never write;
# entries tagged with {run_id, verdict, goal_hash}.
OPGROK_MEMORY=1

# Append a judge node as the decisive sink (I4 DecisiveNodeIsJudgeOrSink).
OPGROK_JUDGE=1

# Enable the toolbelt (read_file, grep, web_fetch, shell when allowed).
OPGROK_TOOLS=1

# ═══════════════════════════════════════════════════════════════════════════
# xAI Imagine API — image & video generation (optional)
# Used by core/toolkit/vision.py for visual asset nodes.
# See: https://docs.x.ai/developers/model-capabilities/images/generation
# ═══════════════════════════════════════════════════════════════════════════

# Image generation model for forge/smith visual asset nodes.
# grok-imagine-image-2.0 — latest, $0.04/image, up to 2K resolution.
# Alternatives: grok-imagine-image-quality ($0.05-0.07/img, highest quality),
#               grok-imagine-image ($0.02/img, standard).
OPGROK_MODEL_IMAGE=grok-imagine-image-2.0

# Video generation model (for future video asset nodes).
# grok-imagine-video-1.5 — latest, $0.08/sec.
# Alternative: grok-imagine-video ($0.05/sec, standard).
OPGROK_MODEL_VIDEO=grok-imagine-video-1.5

# ═══════════════════════════════════════════════════════════════════════════
# Safety gates (v1.0.0 — see WINNING_CONDITION_v1.0.0.md)
# ═══════════════════════════════════════════════════════════════════════════

# Require a live API key — refuse dry-run before any side effect.
# Set to 1 in production/CI to fail loudly on missing keys.
OPGROK_REQUIRE_LIVE=0
